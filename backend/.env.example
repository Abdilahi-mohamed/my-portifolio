PORT=4000
FRONTEND_ORIGIN=https://your-portfolio.example
DATA_DIRECTORY=./data
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
# Optional comma-separated DNS servers if the system resolver refuses MongoDB SRV lookups.
# MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1
MONGODB_DB=portfolio
# Set true only when intentionally seeding an empty production database with the bundled starter content.
PORTFOLIO_INIT_DEFAULTS=false

# Create a bucket and a bucket-scoped application key in Backblaze B2.
# The endpoint must match the bucket's region.
B2_ENDPOINT=https://s3.<region>.backblazeb2.com
B2_REGION=<region>
B2_BUCKET_NAME=your-private-bucket-name
B2_ACCESS_KEY_ID=your-application-key-id
B2_APPLICATION_KEY=your-application-key

ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-private-password-of-at-least-8-characters
ADMIN_AUTH_DISABLED=false
NODE_ENV=production
