MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_DB=abdilahi_portfolio

ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-private-password

# Existing Backblaze B2 configuration
B2_ENDPOINT=https://s3.<region>.backblazeb2.com
B2_REGION=<region>
B2_BUCKET_NAME=your-existing-bucket
B2_ACCESS_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key

# Cloudflare R2 alternative
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_BUCKET_NAME=your-existing-bucket
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
